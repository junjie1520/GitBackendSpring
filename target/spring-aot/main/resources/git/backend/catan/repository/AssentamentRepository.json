    {
      "name": "contarEnExtremos",
      "signature": "public abstract long git.backend.catan.repository.AssentamentRepository.contarEnExtremos(java.lang.Integer,java.lang.Integer,java.lang.Integer)",
      "query": {
        "query": "SELECT COUNT(a) FROM Assentament a WHERE a.propietari.id = :idJugador AND (a.vertex.id = :vA OR a.vertex.id = :vB)"
      }
    },
    {
      "name": "countByPropietariIdAndVertexIdIn",
      "signature": "public abstract long git.backend.catan.repository.AssentamentRepository.countByPropietariIdAndVertexIdIn(java.lang.Integer,java.util.List<java.lang.Integer>)",
      "query": {
        "query": "SELECT COUNT(a) FROM Assentament a WHERE a.propietari.id = :propietariId AND a.vertex.id IN :vertexIds"
      }
    },
    {
      "name": "existsByVertexId",
      "signature": "public abstract boolean git.backend.catan.repository.AssentamentRepository.existsByVertexId(java.lang.Integer)",
      "query": {
        "query": "SELECT a.id FROM Assentament a WHERE a.vertex.id = :vertexId"
      }
