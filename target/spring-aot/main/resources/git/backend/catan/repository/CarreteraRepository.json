  "methods": [
    {
      "name": "comptarConnectadesAVertex",
      "signature": "public abstract long git.backend.catan.repository.CarreteraRepository.comptarConnectadesAVertex(java.lang.Integer,java.lang.Integer)",
      "query": {
        "query": "SELECT COUNT(c) FROM Carretera c WHERE c.propietari.id = :jugadorId AND (c.aresta.vertexA.id = :vertexId OR c.aresta.vertexB.id = :vertexId)"
      }
    },
    {
      "name": "contarCarreterasConectadas",
      "signature": "public abstract long git.backend.catan.repository.CarreteraRepository.contarCarreterasConectadas(java.lang.Integer,java.lang.Integer,java.lang.Integer,java.lang.Integer)",
      "query": {
        "query": "SELECT COUNT(c) FROM Carretera c WHERE c.propietari.id = :idJugador AND c.aresta.id <> :idAresta AND (c.aresta.vertexA.id = :vA OR c.aresta.vertexB.id = :vA OR c.aresta.vertexA.id = :vB OR c.aresta.vertexB.id = :vB)"
      }
    },
    {
      "name": "countByPropietariId",
      "signature": "public abstract long git.backend.catan.repository.CarreteraRepository.countByPropietariId(java.lang.Integer)",
      "query": {
        "query": "SELECT COUNT(c) FROM Carretera c WHERE c.propietari.id = :propietariId"
      }
    },
    {
      "name": "existsByArestaId",
      "signature": "public abstract boolean git.backend.catan.repository.CarreteraRepository.existsByArestaId(java.lang.Integer)",
      "query": {
        "query": "SELECT c.id FROM Carretera c WHERE c.aresta.id = :idAresta"
      }
    },
